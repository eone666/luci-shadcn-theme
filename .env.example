# Цель OpenWrt = архитектура образа. Apple Silicon / ARM: aarch64_generic,
# Intel/AMD: x86_64. Список тегов: hub.docker.com/r/openwrt/rootfs/tags
OPENWRT_ARCH=aarch64_generic
OPENWRT_VERSION=25.12.4

# Логин в LuCI и по SSH: root / <ROOT_PASSWORD>
ROOT_PASSWORD=openwrt

# Активная тема стенда
LUCI_THEME=shadcn-dark

HTTP_PORT=8080
HTTPS_PORT=8443
SSH_PORT=2222
