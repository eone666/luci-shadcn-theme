{
  "name": "luci-theme-shadcn",
  "version": "1.0.1",
  "private": true,
  "description": "A shadcn/ui-styled theme for LuCI, the OpenWrt web interface",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "playwright-core": "^1.62.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "tokens": "node scripts/tokens.mjs",
    "audit": "node scripts/audit-selectors.mjs",
    "check": "npm run build && npm run audit",
    "package": "sh scripts/package.sh",
    "package:check": "sh scripts/package-check.sh",
    "release": "node scripts/release.mjs",
    "bench": "docker compose up -d --wait && echo \"LuCI on http://$(docker compose port openwrt 80 | sed 's/^0\\.0\\.0\\.0/localhost/')\"",
    "bench:down": "docker compose down",
    "bench:logs": "docker compose logs -f",
    "shots": "node scripts/shots.mjs",
    "shots:states": "node scripts/states.mjs",
    "inspect": "node scripts/inspect.mjs",
    "clean": "rm -rf .build .sdk-out src/generated shots"
  }
}
