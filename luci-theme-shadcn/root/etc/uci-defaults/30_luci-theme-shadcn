#!/bin/sh

changed=0

set_opt() {
	local key=$1
	local val=$2

	if ! uci -q get "luci.$key" 2>/dev/null; then
		uci set "luci.$key=$val"
		changed=1
	fi
}

# Three variants of one theme: shadcn follows prefers-color-scheme, the other
# two pin the mode (see darkpref in ucode/template/themes/shadcn/header.ut).
# mediaurlbase is deliberately left alone: installing a theme must not silently
# switch the interface — that choice stays with System -> Language and Style
# -> Design.
set_opt themes.Shadcn /luci-static/shadcn
set_opt themes.ShadcnDark /luci-static/shadcn-dark
set_opt themes.ShadcnLight /luci-static/shadcn-light

if [ $changed = 1 ]; then
	uci commit luci
fi

exit 0
